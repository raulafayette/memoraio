#!/bin/zsh
set -eu
project_root="${0:A:h:h:h:h}"
# Automated launcher test/fallback with an explicitly provided data directory.
if [[ -n "${MEMORIA_DATA:-}" ]]; then
  mkdir -p "$MEMORIA_DATA"
  exec "$project_root/Abrir.command" >> "$MEMORIA_DATA/session.log" 2>&1
fi
# Reading an adjacent script in Documents can be denied by macOS privacy.
# The GUI launcher only reads its private Library state, never project files.
/opt/homebrew/bin/python3.12 -c '
from pathlib import Path
import json,subprocess,time
from urllib.parse import urlsplit
state=Path.home()/"Library"/"Application Support"/"MemoriaAudiovisual"/"ui-session.json"
for attempt in range(30):
    try:
        url=json.loads(state.read_text())["url"]
        parsed=urlsplit(url)
        if parsed.scheme!="http" or parsed.hostname!="127.0.0.1":raise ValueError("Sessão local inválida")
        import http.client
        c=http.client.HTTPConnection(parsed.hostname,parsed.port,timeout=2)
        c.request("GET",parsed.path+"?"+parsed.query);r=c.getresponse();r.read();status=r.status;c.close()
        if status!=303:raise RuntimeError("Sessão ainda iniciando")
        subprocess.run(["/usr/bin/open",url],check=True)
        health=state.with_name("launcher-health.json")
        health.write_text(json.dumps({"at":time.time(),"event":"browser_open_requested","success":True}))
        health.chmod(0o600)
        break
    except (OSError,ValueError,KeyError,RuntimeError):
        if attempt==29:
            subprocess.run(["/usr/bin/osascript","-e","display alert \"Memória audiovisual\" message \"Serviço indisponível. Execute Instalar.command na pasta do projeto ou consulte o guia de operação.\""])
        else:time.sleep(.4)
'
